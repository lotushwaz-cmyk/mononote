<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 이상 자동 백업 / 기기 간 이동 규칙 -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="data.json" />
        <include domain="file" path="images/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="data.json" />
        <include domain="file" path="images/" />
    </device-transfer>
</data-extraction-rules>
